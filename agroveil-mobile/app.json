{
  "expo": {
    "name": "AgroVeil",
    "slug": "agroveil-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "agroveil",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "AgroVeil utilise la caméra pour surveiller la santé de votre troupeau en temps réel grâce à l'intelligence artificielle.",
        "NSMicrophoneUsageDescription": "AgroVeil peut enregistrer l'audio pour l'analyse comportementale."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#131313",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "com.google.android.c2dm.permission.RECEIVE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "AgroVeil utilise la caméra pour surveiller la santé de votre troupeau en temps réel grâce à l'intelligence artificielle."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#8bd88e",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "AgroVeil Alerte"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
